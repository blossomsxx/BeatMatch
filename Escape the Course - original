#person
person=Group(Circle(99,150,4,opacity=80),
Rect(97,153,5,10,opacity=80),
Polygon(102,163,102,168,100,168,100,163,opacity=80),
Polygon(97,163,97,168,99,168,99,163,opacity=80),
Polygon(97,155,96,157,92,158,93,158,94,156,95,155,opacity=80))

person.energy=0

def onMousePress(x,y):
    person.energy+=1
    if(person.energy>=5):
        person.opacity=0


#press keys to move character
def onKeyPress(key):
    instructions.visible=False
    if(endPoint.hitsShape(person)):
        drawWinScreen('green',"You Win!",'white')
        app.background='white'
    elif(obstacle1.hitsShape(person)):
        drawWinScreen('red','You Died!','white')
        app.background='gray'
    elif(obstacle2.hitsShape(person)):
        drawWinScreen('red','You Died!','white')
        app.background='gray'
        person.rotateAngle+=90
    elif(person.centerX<=20):
        drawLoseScreen ('red','You Died!','white')
        app.background='gray'
        person.rotateAngle+=90
    elif(person.centerX>=385):
        person.centerX=380
    elif(person.centerY<=20):
        person.centerY=20
    elif(person.centerY>=385):
        person.centerY=380
    elif(key=='up'):
        person.centerY-=20
    elif(key=='space'):
        person.centerY-=20
    elif(key=='right'):
        person.centerX+=20
    elif(key=='left'):
        person.centerX-=20
    elif(key=='down'):
        person.centerY+=20

def onKeyRelease(key):
    if(key=='up'):
        person.centerY+=20
